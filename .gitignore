# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/
.env

# Simulation artifacts
*.vvp
*.vcd
*.out
*.log

# Model weights and downloads
*.gguf
*.bin
models/weights/

# Bulky per-iteration run data — commit summaries only
results/**/iter_*/
results/**/*.v
results/**/llm_response.txt
results/**/sim_log.txt
results/**/feedback.txt

# HPC pulls and legacy result trees
runs/hpc_pull/
results_stitch/
results_v2/
storeandmisc/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only working notes and machine-specific config.
# Kept in the repo folder for convenience, deliberately NOT tracked:
# they contain absolute local paths, machine setup, and model/runtime
# details that are specific to one workstation.
NOTE.txt
HANDOFF.md
handoff*.md
# Exception: handoff.md at repo root is a TRACKED deliverable (the Phase 0 ->
# Phase 1 handoff written 2026-08-19), not a local working doc. On a
# case-insensitive filesystem this is the same physical file HANDOFF.md used
# to be -- that file's content was overwritten when handoff.md was created
# and is not recoverable (it was gitignored, so git never held a copy).
!/handoff.md
notes.txt
NOTES.txt
local_*.txt
local_*.md
*.local.yaml
*.local.json
models/local_config.yaml
models/frontier_config.yaml
scratch/
paper_112_final.pdf
AutoChip_HPC_Reference.docx

# Private notes live in private/ (local only, never committed). Root-anchored, so docs/reSTITCH.md is tracked.
private/
/reSTITCH.md
/reSTITCH_PHASE3_EXPLAINED.md
/note.txt

# --- Phase 3 (MPSoC composition + interpreter v3) ---
# Local run output (E0 retro-audit, smoke runs): regenerable, never committed.
phase3/results/
# Local silicon PPA analysis inputs and generated plots; summary is tracked separately.
/SiliconComparision/latch_study/stitch_noc_analysis_bundle/
# LLM one-shot vs STITCH study: regenerable or duplicate output (see the study README, "Not in git").
/SiliconComparision/llm_oneshot_vs_stitch/assembled/
/SiliconComparision/llm_oneshot_vs_stitch/runs/arms/results/**/iter*/tb*.v
/SiliconComparision/llm_oneshot_vs_stitch/runs/inventory/a1_proc.json
/SiliconComparision/llm_oneshot_vs_stitch/runs/inventory/handwritten_hierarchy.json
/SiliconComparision/llm_oneshot_vs_stitch/**/*.vvp
/SiliconComparision/llm_oneshot_vs_stitch/**/*.vcd
/SiliconComparision/llm_oneshot_vs_stitch/**/obj_dir/
# run logs are evidence (cited path:line by reports/TAXONOMY.md and FAILURE_AUDIT.md), despite *.log above
!/SiliconComparision/llm_oneshot_vs_stitch/runs/**/*.log
/SiliconComparision/llm_oneshot_vs_stitch/hpc_logs/
# Drop leftovers: the source archive, and the one-off snippet already merged into .gitattributes.
STITCH_phase3_drop.zip
STITCH_phase3_drop/
phase3/GITATTRIBUTES_ADDITIONS.txt
# (phase3/HANDOFF_PHASE3_CLAUDE_CODE.md is already covered by the handoff*.md rule above.)
# The real Yosys/Verilator logs are frozen test evidence (44 tests + validate_tasks read them),
# so re-include them despite the global *.log rule.
!phase3/**/*.log
stitch-api-key.txt

# Secrets. API keys live in %USERPROFILE%\.stitch\api_keys.env, outside the repo; never commit any .env.
*.env

# LaTeX build output: compile into paper/build/ (pdflatex -output-directory=build).
paper/build/
# The paper (v11) builds in place (latexmk -pdf main.tex); its PDF is an output, not a source.
paper/*.pdf
# Superseded paper drafts (v7 to v10, the supplement, old zips): local only. v10 is in git history at e77bf73.
paper/archive/
*.aux
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.lof
*.lot
